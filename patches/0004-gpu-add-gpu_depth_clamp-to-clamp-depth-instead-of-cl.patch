From 67e7ed8eba183baf99ade61585554dcd7d658659 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:49:03 -0600
Subject: [PATCH 04/24] gpu: add gpu_depth_clamp to clamp depth instead of
 clipping in Z

Xenos does not seem to clip primitives against the near/far planes: GRAW
(555307D5) draws its sky dome beyond its own far plane with
PA_CL_CLIP_CNTL.clip_disable = 0 and expects it to be visible. With depth
clipping the sky is cut away and the scene behind it shows through.

New cvar gpu_depth_clamp (default false). When set, D3D12 pipelines use
DepthClipEnable = FALSE and Vulkan pipelines enable depthClamp, so depth
is clamped to the viewport range instead of the primitive being clipped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/flags.h           | 1 +
 src/graphics/d3d12/pipeline_cache.cpp  | 3 ++-
 src/graphics/flags.cpp                 | 5 +++++
 src/graphics/vulkan/pipeline_cache.cpp | 4 +++-
 4 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/include/rex/graphics/flags.h b/include/rex/graphics/flags.h
index 2cf24c4..e83cc2b 100644
--- a/include/rex/graphics/flags.h
+++ b/include/rex/graphics/flags.h
@@ -46,6 +46,7 @@ REXCVAR_DECLARE(bool, direct_host_resolve);
 
 // GPU Textures
 REXCVAR_DECLARE(bool, gpu_allow_invalid_fetch_constants);
+REXCVAR_DECLARE(bool, gpu_depth_clamp);
 REXCVAR_DECLARE(bool, gpu_3d_to_2d_texture);
 REXCVAR_DECLARE(int32_t, anisotropic_override);
 REXCVAR_DECLARE(int32_t, texture_cache_memory_limit_render_to_texture);
diff --git a/src/graphics/d3d12/pipeline_cache.cpp b/src/graphics/d3d12/pipeline_cache.cpp
index 8e6b854..7f8d73b 100644
--- a/src/graphics/d3d12/pipeline_cache.cpp
+++ b/src/graphics/d3d12/pipeline_cache.cpp
@@ -1428,7 +1428,8 @@ bool PipelineCache::GetCurrentStateDescription(
   if (tessellated && REXCVAR_GET(d3d12_tessellation_wireframe)) {
     description_out.fill_mode_wireframe = 1;
   }
-  description_out.depth_clip = !regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable;
+  description_out.depth_clip =
+      !regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable && !REXCVAR_GET(gpu_depth_clamp);
   bool depth_stencil_bound_and_used = false;
   if (!edram_rov_used) {
     // Depth/stencil. No stencil, always passing depth test and no depth writing
diff --git a/src/graphics/flags.cpp b/src/graphics/flags.cpp
index e2983a4..7590264 100644
--- a/src/graphics/flags.cpp
+++ b/src/graphics/flags.cpp
@@ -16,6 +16,11 @@
 REXCVAR_DEFINE_BOOL(gpu_allow_invalid_fetch_constants, false, "GPU",
                     "Allow invalid fetch constants");
 REXCVAR_DEFINE_BOOL(native_2x_msaa, true, "GPU", "Enable native 2x MSAA");
+REXCVAR_DEFINE_BOOL(gpu_depth_clamp, false, "GPU",
+                    "Never clip primitives against the near/far Z planes; clamp depth to the viewport "
+                    "range instead (D3D12 DepthClipEnable = FALSE). Xenos appears to behave this way: "
+                    "555307D5 (GRAW) draws its sky dome 1.5x beyond its own far plane with "
+                    "PA_CL_CLIP_CNTL.clip_disable = 0 and expects it to be visible");
 REXCVAR_DEFINE_BOOL(depth_float24_round, false, "GPU", "Round float24 depth values");
 REXCVAR_DEFINE_BOOL(depth_float24_convert_in_pixel_shader, false, "GPU",
                     "Convert float24 depth in pixel shader");
diff --git a/src/graphics/vulkan/pipeline_cache.cpp b/src/graphics/vulkan/pipeline_cache.cpp
index 91ac08f..c1ee454 100644
--- a/src/graphics/vulkan/pipeline_cache.cpp
+++ b/src/graphics/vulkan/pipeline_cache.cpp
@@ -1460,8 +1460,10 @@ bool VulkanPipelineCache::GetCurrentStateDescription(
   description_out.primitive_topology = primitive_topology;
   description_out.primitive_restart = primitive_processing_result.host_primitive_reset_enabled;
 
+  // gpu_depth_clamp: Xenos does not clip in Z (see the D3D12 pipeline cache), clamp instead.
   description_out.depth_clamp_enable =
-      device_properties.depthClamp && regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable;
+      device_properties.depthClamp &&
+      (regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable || REXCVAR_GET(gpu_depth_clamp));
 
   // Tessellated draws are patch-domain polygonal primitives regardless of guest
   // register ambiguity in non-explicit major mode configurations.
-- 
