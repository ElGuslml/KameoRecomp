From b2b5b8bab5bf9a3f69489e72cc7553eb6d861958 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:49:03 -0600
Subject: [PATCH 06/24] ui: add gpu_backend cvar to choose the GPU plugin
 backend

ReXApp::SetupPresentation called LoadGpuPlugin without a backend, so the
plugin always picked the first backend compiled in (D3D12 on Windows),
even in builds that also include Vulkan.

New init-only cvar gpu_backend: any (default, unchanged behavior), d3d12
or vulkan. The error message on failure now names the backend too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ui/rex_app.cpp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index b94fe9e..a2b3ad5 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -51,6 +51,12 @@ REXCVAR_DEFINE_STRING(gpu_plugin, "", "GPU",
                       "GPU emulation")
     .lifecycle(rex::cvar::Lifecycle::kInitOnly);
 
+REXCVAR_DEFINE_STRING(gpu_backend, "any", "GPU",
+                      "Graphics backend of the GPU plugin: any (the first compiled in, D3D12 on "
+                      "Windows), d3d12 or vulkan")
+    .allowed({"any", "d3d12", "vulkan"})
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
 namespace rex {
 
 // --- ReXApp ---
@@ -314,11 +320,12 @@ bool ReXApp::SetupPresentation() {
   OnPreSetup(config_);
 
   if (!config_.graphics && !config_.gpu_plugin.empty()) {
-    config_.graphics = rex::system::LoadGpuPlugin(config_.gpu_plugin);
+    std::string gpu_backend = REXCVAR_GET(gpu_backend);
+    config_.graphics = rex::system::LoadGpuPlugin(config_.gpu_plugin, gpu_backend);
     if (!config_.graphics) {
       // Fatal by design: no silent headless fallback.
-      auto msg =
-          fmt::format("Failed to load GPU plugin '{}'. See log for details.", config_.gpu_plugin);
+      auto msg = fmt::format("Failed to load GPU plugin '{}' (backend '{}'). See log for details.",
+                             config_.gpu_plugin, gpu_backend);
       REXLOG_ERROR("{}", msg);
       rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, msg);
       return false;
