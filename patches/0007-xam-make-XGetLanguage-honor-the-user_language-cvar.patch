From 6b961841f4569982ff42df2e7c259994a4073d78 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:49:04 -0600
Subject: [PATCH 07/24] xam: make XGetLanguage honor the user_language cvar

XGetLanguage always returned English (inherited code with the game
region hard-coded to NTSC-U) and ignored user_language, which the SDK
already uses for ExGetXConfigSetting. Games that pick their text and
voice language through XGetLanguage could not be switched.

Return user_language, falling back to English for an invalid or
out-of-range value, as upstream Xenia does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/xam/xam_info.cpp | 20 ++++++++------------
 1 file changed, 8 insertions(+), 12 deletions(-)

diff --git a/src/kernel/xam/xam_info.cpp b/src/kernel/xam/xam_info.cpp
index 1fda053..a42ef8d 100644
--- a/src/kernel/xam/xam_info.cpp
+++ b/src/kernel/xam/xam_info.cpp
@@ -15,6 +15,7 @@
 #include <rex/hook.h>
 #include <rex/types.h>
 #include <rex/string.h>
+#include <rex/system/flags.h>
 #include <rex/system/kernel_state.h>
 #include <rex/system/user_module.h>
 #include <rex/system/xenumerator.h>
@@ -183,19 +184,14 @@ u32 XGetGameRegion_entry() {
 }
 
 u32 XGetLanguage_entry() {
-  auto desired_language = XLanguage::kEnglish;
-
-  // Switch the language based on game region.
-  // TODO(benvanik): pull from xex header.
-  uint32_t game_region = XEX_REGION_NTSCU;
-  if (game_region & XEX_REGION_NTSCU) {
-    desired_language = XLanguage::kEnglish;
-  } else if (game_region & XEX_REGION_NTSCJ) {
-    desired_language = XLanguage::kJapanese;
+  // The console returns the dashboard language; here that is user_language
+  // (as in upstream Xenia). The old code always returned English.
+  uint32_t language = REXCVAR_GET(user_language);
+  if (language == uint32_t(XLanguage::kInvalid) ||
+      language >= uint32_t(XLanguage::kMaxLanguages)) {
+    language = uint32_t(XLanguage::kEnglish);
   }
-  // Add more overrides?
-
-  return uint32_t(desired_language);
+  return language;
 }
 
 u32 XamGetCurrentTitleId_entry() {
