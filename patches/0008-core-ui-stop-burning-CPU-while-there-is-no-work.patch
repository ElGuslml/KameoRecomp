From ca822216099b110d521dada9426e8e797b337f33 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:49:16 -0600
Subject: [PATCH 08/24] core, ui: stop burning CPU while there is no work

Two idle loops kept a core busy for no useful work:

- TimerQueue waited with disruptorplus's spin_wait strategy, which runs
  thousands of pause instructions on every wait before even checking the
  deadline. With the 1 ms KeTimeStampBundle timer that happened 1000
  times per second (12-15% of a core). The thread now sleeps on a
  high-resolution waitable timer until the next deadline (at most 1 ms
  at a time, so new timers are noticed as fast as before) and polls the
  ring buffer without blocking. If the timer cannot be created it falls
  back to the original spin wait.

- ImGuiDrawer requested a new UI paint as long as any dialog was
  registered. The achievement toast dialog is registered for the whole
  session, so the presenter repainted at the host refresh rate even
  though the guest outputs far fewer frames. New virtual
  ImGuiDialog::WantsContinuousPaint() (default true); the achievement
  toast only asks for it while a toast is queued or showing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/ui/imgui_dialog.h              |  7 ++
 include/rex/ui/overlay/achievement_toast.h |  3 +
 src/core/timer_queue.cpp                   | 83 +++++++++++++++++++++-
 src/ui/imgui_drawer.cpp                    | 12 +++-
 src/ui/overlay/achievement_toast.cpp       |  6 ++
 5 files changed, 107 insertions(+), 4 deletions(-)

diff --git a/include/rex/ui/imgui_dialog.h b/include/rex/ui/imgui_dialog.h
index a7ab6b3..c5a7b25 100644
--- a/include/rex/ui/imgui_dialog.h
+++ b/include/rex/ui/imgui_dialog.h
@@ -39,6 +39,13 @@ class ImGuiDialog {
 
   void Draw();
 
+  // Whether the dialog currently needs the UI to be repainted continuously
+  // (animation, input). A dialog that stays registered for the whole session
+  // but usually shows nothing (notifications) returns false while idle, so the
+  // presenter only paints when the guest output changes instead of at the host
+  // refresh rate.
+  virtual bool WantsContinuousPaint() { return true; }
+
  protected:
   ImGuiDialog(ImGuiDrawer* imgui_drawer);
 
diff --git a/include/rex/ui/overlay/achievement_toast.h b/include/rex/ui/overlay/achievement_toast.h
index 7642601..bd9ac7e 100644
--- a/include/rex/ui/overlay/achievement_toast.h
+++ b/include/rex/ui/overlay/achievement_toast.h
@@ -35,6 +35,9 @@ class AchievementToastDialog : public AchievementNotificationDialog {
   // Thread-safe: safe to call from any thread, including guest threads.
   void Push(const rex::system::AchievementEvent& event) override;
 
+  // Only while a toast is queued or showing (it is registered all session).
+  bool WantsContinuousPaint() override;
+
  protected:
   void OnDraw(ImGuiIO& io) override;
 
diff --git a/src/core/timer_queue.cpp b/src/core/timer_queue.cpp
index 5cfea05..325cc8b 100644
--- a/src/core/timer_queue.cpp
+++ b/src/core/timer_queue.cpp
@@ -10,7 +10,9 @@
