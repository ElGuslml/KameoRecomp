 #include <algorithm>
+#include <chrono>
 #include <forward_list>
+#include <thread>
 
 #include <disruptorplus/multi_threaded_claim_strategy.hpp>
 #include <disruptorplus/ring_buffer.hpp>
@@ -18,15 +20,71 @@
 #include <disruptorplus/spin_wait_strategy.hpp>
 
 #include <rex/assert.h>
+#include <rex/platform.h>
 #include <rex/thread.h>
 #include <rex/thread/timer_queue.h>
 
+#if REX_PLATFORM_WIN32
+#include "platform_win.h"
+#endif
+
 namespace dp = disruptorplus;
 
 namespace rex::thread {
 
 using WaitItem = TimerQueueWaitItem;
 
+namespace {
+
+// Sleeps for (approximately) the given duration with sub-millisecond precision,
+// without spinning. Returns false if that is not possible, in which case the
+// caller falls back to the spin wait.
+class PreciseSleeper {
+ public:
+  PreciseSleeper() {
+#if REX_PLATFORM_WIN32
+    // High-resolution waitable timers (Windows 10 1803+) do not depend on the
+    // process timer resolution (timeBeginPeriod).
+    timer_ = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                    TIMER_ALL_ACCESS);
+#endif
+  }
+  ~PreciseSleeper() {
+#if REX_PLATFORM_WIN32
+    if (timer_) {
+      CloseHandle(timer_);
+    }
+#endif
+  }
+  PreciseSleeper(const PreciseSleeper&) = delete;
+  PreciseSleeper& operator=(const PreciseSleeper&) = delete;
+
+  bool Sleep(std::chrono::nanoseconds duration) {
+#if REX_PLATFORM_WIN32
+    if (!timer_) {
+      return false;
+    }
+    LARGE_INTEGER due;
+    // Negative = relative, in 100 ns units.
+    due.QuadPart = -std::max<LONGLONG>(1, LONGLONG(duration.count() / 100));
+    if (!SetWaitableTimerEx(timer_, &due, 0, nullptr, nullptr, nullptr, 0)) {
+      return false;
+    }
+    return WaitForSingleObject(timer_, INFINITE) == WAIT_OBJECT_0;
+#else
+    std::this_thread::sleep_for(duration);
+    return true;
+#endif
+  }
+
+ private:
+#if REX_PLATFORM_WIN32
+  HANDLE timer_ = nullptr;
+#endif
+};
+
+}  // namespace
+
 class TimerQueue {
  public:
   using clock = WaitItem::clock;
@@ -64,12 +122,31 @@ class TimerQueue {
 
     set_current_thread_name("rex::thread::TimerQueue");
 
+    // The spin wait strategy burns 0.1-0.2 ms of pause loops on every wait
+    // before even checking the timeout, and the 1 ms KeTimeStampBundle timer
+    // makes it wait 1000 times per second (12-15% of a core in practice).
+    // Instead, sleep until the next timer is due (at most 1 ms at a time, so a
+    // newly queued timer is noticed as quickly as the spin wait's own 1 ms
+    // sleeps would) and then poll the ring buffer without blocking.
+    constexpr auto kMaxSleep = std::chrono::milliseconds(1);
+    PreciseSleeper sleeper;
+    bool precise_sleep = true;
+
     while (!stop_token.stop_requested()) {
       {
         // Consume new wait items and add them to sorted wait queue
-        dp::sequence_t available = claim_strategy_.wait_until_published(
-            next_sequence, next_sequence - 1,
-            wait_queue_.empty() ? clock::time_point::max() : wait_queue_.front()->due_);
+        dp::sequence_t available;
+        if (precise_sleep && !wait_queue_.empty()) {
+          auto remaining = wait_queue_.front()->due_ - clock::now();
+          if (remaining > clock::duration::zero()) {
+            precise_sleep = sleeper.Sleep(std::min<clock::duration>(remaining, kMaxSleep));
+          }
+          available = claim_strategy_.last_published_after(next_sequence - 1);
+        } else {
+          available = claim_strategy_.wait_until_published(
+              next_sequence, next_sequence - 1,
+              wait_queue_.empty() ? clock::time_point::max() : wait_queue_.front()->due_);
+        }
 
         // Check for timeout
         if (available != next_sequence - 1) {
diff --git a/src/ui/imgui_drawer.cpp b/src/ui/imgui_drawer.cpp
index f270f3c..f80c549 100644
--- a/src/ui/imgui_drawer.cpp
+++ b/src/ui/imgui_drawer.cpp
@@ -439,7 +439,17 @@ void ImGuiDrawer::Draw(UIDrawContext& ui_draw_context) {
   if (!dialogs_.empty()) {
     // Repaint (and handle input) continuously if still active. In detached mode
     // there is no presenter; the app drives repaint via its own present loop.
-    if (presenter_) {
+    // Dialogs that are idle (always-registered notifications with nothing to
+    // show) don't count: otherwise the presenter repaints at the host refresh
+    // rate for the whole session even though the guest outputs 60 frames.
+    bool wants_continuous_paint = false;
+    for (ImGuiDialog* dialog : dialogs_) {
+      if (dialog->WantsContinuousPaint()) {
+        wants_continuous_paint = true;
+        break;
+      }
+    }
+    if (presenter_ && wants_continuous_paint) {
       presenter_->RequestUIPaintFromUIThread();
     }
   }
diff --git a/src/ui/overlay/achievement_toast.cpp b/src/ui/overlay/achievement_toast.cpp
index 53b8c0b..237d19d 100644
--- a/src/ui/overlay/achievement_toast.cpp
+++ b/src/ui/overlay/achievement_toast.cpp
@@ -29,6 +29,12 @@ void AchievementToastDialog::Push(const rex::system::AchievementEvent& event) {
   queue_.push_back({event, std::chrono::steady_clock::now()});
 }
 
+bool AchievementToastDialog::WantsContinuousPaint() {
+  // A new toast is picked up by the next paint caused by a guest frame.
+  std::lock_guard<std::mutex> lock(mutex_);
+  return !queue_.empty();
+}
+
 void AchievementToastDialog::OnDraw(ImGuiIO& io) {
   auto now = std::chrono::steady_clock::now();
 
