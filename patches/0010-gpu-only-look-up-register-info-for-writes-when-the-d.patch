From d4c8f0cfc946955f7f0e00f2c2a47869c2c8545d Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:49:44 -0600
Subject: [PATCH 10/24] gpu: only look up register info for writes when the
 debug log is on

CommandProcessor::WriteRegister called RegisterFile::GetRegisterInfo (a
switch with about 1000 cases) on every register write, only to decide
whether to emit a debug-level "unknown register" message. Games write
hundreds of thousands of registers per frame, so the lookup showed up
near the top of the command processor thread's profile.

Check once whether the GPU log is enabled at debug level and skip the
lookup otherwise.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/command_processor.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..db06840 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -355,7 +355,13 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile uint32_t&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
+  // Perf: GetRegisterInfo is a ~1000-case switch and this runs for every
+  // register write (hundreds of thousands per frame); only consult it when the debug log is enabled.
+  static const bool log_unknown_registers = [] {
+    auto* gpu_log = ::rex::GetLoggerRaw(::rex::log::gpu());
+    return gpu_log && gpu_log->should_log(spdlog::level::debug);
+  }();
+  if (log_unknown_registers && !regs.GetRegisterInfo(index)) {
     REXGPU_DEBUG("GPU: Write to unknown register ({:04X} = {:08X})", index, value);
   }
 
