From 309a4f67b61011b36a698f9ba2d64be88767cec2 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:51:32 -0600
Subject: [PATCH 14/24] memory: log guest context on unhandled guest access
 violations

When the game makes an invalid access that nothing handles, the process
dies with only the faulting address in the log. A Windows minidump has
the host stack (for recompiled code that is the guest call chain) but
not guest memory, so the objects involved cannot be examined.

Before returning from the unhandled case, log [CRASH] lines with the
faulting guest thread's registers, its stack back chain (saved return
addresses) and the memory that r3-r31 point to (256 bytes for r3/r4,
64 for the rest). Memory is only read after asking the OS whether it is
readable, without taking SDK heap locks, and physical heaps are skipped
because their pages may be watched. No cost unless the process is
already crashing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/system/xmemory.cpp | 105 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 105 insertions(+)

diff --git a/src/system/xmemory.cpp b/src/system/xmemory.cpp
index 621b967..bc99734 100644
--- a/src/system/xmemory.cpp
+++ b/src/system/xmemory.cpp
@@ -25,9 +25,12 @@
 #include <rex/logging.h>
 #include <rex/math.h>
 #include <rex/stream.h>
+#include <rex/memory/utils.h>
 #include <rex/system/function_dispatcher.h>
 #include <rex/system/mmio_handler.h>
+#include <rex/system/thread_state.h>
 #include <rex/system/xmemory.h>
+#include <rex/system/xthread.h>
 #include <rex/thread.h>
 
 // TODO(benvanik): move xbox.h out
@@ -537,6 +540,107 @@ runtime::MMIORange* Memory::LookupVirtualMappedRange(uint32_t virtual_address) {
   return mmio_handler_->LookupRange(virtual_address);
 }
 
+namespace {
+
+// Whether [address, address + length) of guest virtual memory can be read
+// without faulting. Asks the host OS (no SDK heap locks: this runs inside the
+// access violation handler with the global lock held), and skips physical
+// heaps, whose pages may be watched (no-access) for the GPU.
+bool IsGuestRangeReadable(Memory* memory, uint32_t address, uint32_t length) {
+  if (address < 0x10000 || uint64_t(address) + length > 0x100000000ull) {
+    return false;
+  }
+  for (uint32_t probe : {address, address + length - 1}) {
+    const BaseHeap* heap = memory->LookupHeap(probe);
+    if (!heap || heap->heap_type() == HeapType::kGuestPhysical) {
+      return false;
+    }
+  }
+  uint8_t* host = memory->TranslateVirtual<uint8_t*>(address);
+  uint8_t* host_end = host + length;
+  while (host < host_end) {
+    size_t region_length = 0;
+    PageAccess access;
+    if (!rex::memory::QueryProtect(host, region_length, access) ||
+        !(uint32_t(access) & uint32_t(PageAccess::kReadOnly))) {
+      return false;
+    }
+    // region_length counts from the start of host's page.
+    uint8_t* page = reinterpret_cast<uint8_t*>(reinterpret_cast<uintptr_t>(host) & ~uintptr_t(0xFFF));
+    if (!region_length) {
+      return false;
+    }
+    host = page + region_length;
+  }
+  return true;
+}
+
+void LogGuestMemory(Memory* memory, const char* name, uint32_t address, uint32_t length) {
+  if (!IsGuestRangeReadable(memory, address, length)) {
+    return;
+  }
+  const uint8_t* host = memory->TranslateVirtual<const uint8_t*>(address);
+  for (uint32_t offset = 0; offset < length; offset += 32) {
+    std::string line = fmt::format("[CRASH] {} {:08X} +{:03X}:", name, address, offset);
+    for (uint32_t i = offset; i < offset + 32 && i < length; i += 4) {
+      line += fmt::format(" {:08X}", rex::memory::load_and_swap<uint32_t>(host + i));
+    }
+    REXSYS_ERROR("{}", line);
+  }
+}
+
+// A Windows minidump of an unhandled guest
+// access violation has the host stack (the recompiled functions are the guest
+// call chain) but not guest memory. Log the faulting guest thread's registers,
+// its stack back chain and the memory the pointer-like registers point to, so
+// the object involved can be examined from the log. Register values are those
+// stored in the context; ones the recompiled code keeps in host registers may
+// be newer than what is printed.
+void LogGuestCrashContext(Memory* memory) {
+  auto* thread = rex::system::XThread::GetCurrentThread();
+  if (!thread || !thread->thread_state() || !thread->thread_state()->context()) {
+    return;
+  }
+  const PPCContext& ctx = *thread->thread_state()->context();
+  const PPCRegister* gprs[32] = {
+      &ctx.r0,  &ctx.r1,  &ctx.r2,  &ctx.r3,  &ctx.r4,  &ctx.r5,  &ctx.r6,  &ctx.r7,
+      &ctx.r8,  &ctx.r9,  &ctx.r10, &ctx.r11, &ctx.r12, &ctx.r13, &ctx.r14, &ctx.r15,
+      &ctx.r16, &ctx.r17, &ctx.r18, &ctx.r19, &ctx.r20, &ctx.r21, &ctx.r22, &ctx.r23,
+      &ctx.r24, &ctx.r25, &ctx.r26, &ctx.r27, &ctx.r28, &ctx.r29, &ctx.r30, &ctx.r31};
+  REXSYS_ERROR("[CRASH] guest thread {:08X} lr={:08X} ctr={:08X}", thread->handle(),
+               uint32_t(ctx.lr), ctx.ctr.u32);
+  for (int i = 0; i < 32; i += 8) {
+    REXSYS_ERROR("[CRASH] r{}-r{}: {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}", i,
+                 i + 7, gprs[i]->u32, gprs[i + 1]->u32, gprs[i + 2]->u32, gprs[i + 3]->u32,
+                 gprs[i + 4]->u32, gprs[i + 5]->u32, gprs[i + 6]->u32, gprs[i + 7]->u32);
+  }
+  // Guest stack back chain: [sp] = caller's sp, saved LR at caller's sp - 8
+  // (stw r12,-8(r1) / __savegprlr). A leaf function without a frame doesn't
+  // appear (its return address is lr).
+  std::string chain;
+  uint32_t sp = ctx.r1.u32;
+  for (int depth = 0; depth < 24 && IsGuestRangeReadable(memory, sp, 4); ++depth) {
+    uint32_t back = rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual<uint8_t*>(sp));
+    if (back <= sp || back - sp > 0x100000 || !IsGuestRangeReadable(memory, back - 8, 4)) {
+      break;
+    }
+    chain += fmt::format(" {:08X}", rex::memory::load_and_swap<uint32_t>(
+                                        memory->TranslateVirtual<uint8_t*>(back - 8)));
+    sp = back;
+  }
+  REXSYS_ERROR("[CRASH] guest stack (return addresses):{}", chain);
+  for (int i = 3; i < 32; ++i) {
+    if (i == 13) {
+      continue;  // r13 = PCR
+    }
+    uint32_t value = gprs[i]->u32;
+    LogGuestMemory(memory, fmt::format("r{}", i).c_str(), value & ~3u,
+                   (i == 3 || i == 4) ? 256 : 64);
+  }
+}
+
+}  // namespace
+
 bool Memory::AccessViolationCallback(std::unique_lock<std::recursive_mutex> global_lock_locked_once,
                                      void* host_address, bool is_write) {
   // Access via physical_membase_ is special, when need to bypass everything
@@ -553,6 +657,7 @@ bool Memory::AccessViolationCallback(std::unique_lock<std::recursive_mutex> glob
         "Unhandled guest access violation: {} of guest 0x{:08X} (host 0x{:016X}) on thread 0x{:X}",
         is_write ? "write" : "read", virtual_address, reinterpret_cast<uintptr_t>(host_address),
         rex::thread::current_thread_id());
+    LogGuestCrashContext(this);
     return false;
   }
 
