From 04c7066f62c4d423a3348950dc7943ba70b89094 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:52:54 -0600
Subject: [PATCH 15/24] gpu: add gpu_guest_fps_limit to cap the guest frame
 rate

Some game logic may depend on the frame rate the game ran at on the
console, which was often well below 60. To test or reproduce that, the
guest needs to run slower without changing the 60 Hz vblank.

New cvar gpu_guest_fps_limit (default 0 = off). After each guest swap
the command processor waits until 1/limit s has passed since the
previous one, keeping the cadence unless a frame is more than an interval
late. The game's render thread then waits for the ring buffer, so the
whole game runs at that rate, as with a slower GPU.

The wait uses the new rex::thread::PreciseSleep: on Windows a per-thread
high-resolution waitable timer (independent of the system timer
resolution, falling back to Sleep), on POSIX nanosleep via Sleep.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/flags.h       |  1 +
 include/rex/thread.h               |  6 ++++++
 src/core/threading_posix.cpp       |  5 +++++
 src/core/threading_win.cpp         | 26 ++++++++++++++++++++++++++
 src/graphics/command_processor.cpp | 26 ++++++++++++++++++++++++++
 src/graphics/flags.cpp             |  3 +++
 6 files changed, 67 insertions(+)

diff --git a/include/rex/graphics/flags.h b/include/rex/graphics/flags.h
index 57c64c2..9e27afe 100644
--- a/include/rex/graphics/flags.h
+++ b/include/rex/graphics/flags.h
@@ -48,6 +48,7 @@ REXCVAR_DECLARE(bool, direct_host_resolve);
 REXCVAR_DECLARE(bool, gpu_allow_invalid_fetch_constants);
 REXCVAR_DECLARE(bool, gpu_depth_clamp);
 REXCVAR_DECLARE(bool, gpu_async_pipelines_no_frame_wait);
+REXCVAR_DECLARE(int32_t, gpu_guest_fps_limit);
 REXCVAR_DECLARE(bool, gpu_3d_to_2d_texture);
 REXCVAR_DECLARE(int32_t, anisotropic_override);
 REXCVAR_DECLARE(int32_t, texture_cache_memory_limit_render_to_texture);
diff --git a/include/rex/thread.h b/include/rex/thread.h
index 30b207d..83e11a4 100644
--- a/include/rex/thread.h
+++ b/include/rex/thread.h
@@ -118,6 +118,12 @@ void Sleep(std::chrono::duration<Rep, Period> duration) {
   Sleep(std::chrono::duration_cast<std::chrono::microseconds>(duration));
 }
 
+// Sleeps for about the given duration with sub-millisecond precision, without
+// depending on the system timer resolution (Sleep() above rounds down to whole
+// milliseconds and wakes at the timer resolution). On Windows it uses a
+// per-thread high-resolution waitable timer, falling back to Sleep().
+void PreciseSleep(std::chrono::microseconds duration);
+
 enum class SleepResult {
   kSuccess,
   kAlerted,
diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index 9ac8d15..9f93871 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -206,6 +206,11 @@ void Sleep(std::chrono::microseconds duration) {
   } while (ret == -1 && errno == EINTR);
 }
 
+void PreciseSleep(std::chrono::microseconds duration) {
+  // nanosleep is already precise.
+  Sleep(duration);
+}
+
 // TODO(bwrsandman) Implement by allowing alert interrupts from IO operations
 thread_local bool alertable_state_ = false;
 bool DispatchCurrentThreadUserCallback();
diff --git a/src/core/threading_win.cpp b/src/core/threading_win.cpp
index 896dfec..9395ba3 100644
--- a/src/core/threading_win.cpp
+++ b/src/core/threading_win.cpp
@@ -101,6 +101,32 @@ void Sleep(std::chrono::microseconds duration) {
   }
 }
 
+void PreciseSleep(std::chrono::microseconds duration) {
+  if (duration.count() <= 0) {
+    return;
+  }
+  struct HighResolutionTimer {
+    // Windows 10 1803+; independent of timeBeginPeriod.
+    HANDLE handle = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                           TIMER_ALL_ACCESS);
+    ~HighResolutionTimer() {
+      if (handle) {
+        CloseHandle(handle);
+      }
+    }
+  };
+  thread_local HighResolutionTimer timer;
+  if (timer.handle) {
+    LARGE_INTEGER due;
+    due.QuadPart = -LONGLONG(duration.count()) * 10;  // relative, 100 ns units
+    if (SetWaitableTimerEx(timer.handle, &due, 0, nullptr, nullptr, nullptr, 0) &&
+        WaitForSingleObject(timer.handle, INFINITE) == WAIT_OBJECT_0) {
+      return;
+    }
+  }
+  Sleep(duration);
+}
+
 SleepResult AlertableSleep(std::chrono::microseconds duration) {
   if (SleepEx(static_cast<DWORD>(duration.count() / 1000), TRUE) == WAIT_IO_COMPLETION) {
     return SleepResult::kAlerted;
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 9428a78..b201754 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -34,6 +34,7 @@
 #include <rex/stream.h>
 #include <rex/system/kernel_state.h>
 #include <rex/system/user_module.h>
+#include <rex/thread.h>
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
 
@@ -991,6 +992,31 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
 
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
+  // gpu_guest_fps_limit: hold the command processor after a guest
+  // frame so the next one isn't swapped before 1/limit s has passed. The game's
+  // render thread then waits for the ring buffer and the whole game runs at
+  // that rate, as with a slower GPU; the vblank keeps its 60 Hz. Only the
+  // command processor thread gets here.
+  static uint64_t fps_limit_next_swap = 0;
+  if (int32_t fps_limit = REXCVAR_GET(gpu_guest_fps_limit); fps_limit > 0) {
+    uint64_t frequency = rex::chrono::Clock::QueryHostTickFrequency();
+    uint64_t interval = frequency / uint64_t(fps_limit);
+    uint64_t now = rex::chrono::Clock::QueryHostTickCount();
+    if (fps_limit_next_swap && now < fps_limit_next_swap) {
+      rex::thread::PreciseSleep(
+          std::chrono::microseconds((fps_limit_next_swap - now) * 1000000 / frequency));
+      now = rex::chrono::Clock::QueryHostTickCount();
+    }
+    // Keep the cadence unless this frame came more than an interval late.
+    if (fps_limit_next_swap && now < fps_limit_next_swap + interval) {
+      fps_limit_next_swap += interval;
+    } else {
+      fps_limit_next_swap = now + interval;
+    }
+  } else {
+    fps_limit_next_swap = 0;
+  }
+
   ++counter_;
   return true;
 }
diff --git a/src/graphics/flags.cpp b/src/graphics/flags.cpp
index 322413c..6ce5c9c 100644
--- a/src/graphics/flags.cpp
+++ b/src/graphics/flags.cpp
@@ -26,6 +26,9 @@ REXCVAR_DEFINE_BOOL(gpu_async_pipelines_no_frame_wait, false, "GPU",
                     "the pipelines still being created. Draws using them are already skipped until "
                     "they are ready, so a new object appears a few frames later instead of the "
                     "frame stalling for the whole creation (100-250 ms for a new pipeline)");
+REXCVAR_DEFINE_INT32(gpu_guest_fps_limit, 0, "GPU",
+                     "Limit the game's own frame rate (guest swaps per second), e.g. 30 to run like a "
+                     "slower console. The vblank stays at 60 Hz. 0 = no limit");
 REXCVAR_DEFINE_BOOL(depth_float24_round, false, "GPU", "Round float24 depth values");
 REXCVAR_DEFINE_BOOL(depth_float24_convert_in_pixel_shader, false, "GPU",
                     "Convert float24 depth in pixel shader");
