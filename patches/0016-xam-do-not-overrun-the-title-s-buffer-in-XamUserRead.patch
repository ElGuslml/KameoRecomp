From 01d4cba848aa2d9cf0ba5cb7498fbc2af5d78e76 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sun, 11 Oct 2026 12:47:48 -0600
Subject: [PATCH 16/24] xam: do not overrun the title's buffer in
 XamUserReadProfileSettings

The size reported by the first call (buffer == NULL) added the nominal
maximum of each WSTRING/BINARY setting, taken from the size field of the
setting key (1000 bytes for the title-specific settings). The second call
then appended the stored value, whose size XamUserWriteProfileSettings
does not limit. Pirates of the Caribbean: At World's End writes 1024
bytes into each of the three title-specific settings; reading them back
wrote 72 bytes of the saved data (zeros) past the 3728-byte buffer the
game allocated, destroying the header of the next block of its heap.
The game crashed a moment later when its allocator walked the heap
(invalid write at 0x1300), always when leaving the title screen, and only
after the first run had created the profile files.

Settings now report the size Append will write (data_size()); the size
query adds the larger of the key's maximum and the stored value, so the
title allocates enough, and the fill loop skips a setting that would not
fit instead of writing past the buffer.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 include/rex/system/xam/user_profile.h |  5 +++++
 src/kernel/xam/xam_user.cpp           | 29 ++++++++++++++++++++++-----
 2 files changed, 29 insertions(+), 5 deletions(-)

diff --git a/include/rex/system/xam/user_profile.h b/include/rex/system/xam/user_profile.h
index ec37017..874ca8b 100644
--- a/include/rex/system/xam/user_profile.h
+++ b/include/rex/system/xam/user_profile.h
@@ -117,6 +117,9 @@ class UserProfile {
       (void)stream;
       data->type = static_cast<uint8_t>(type);
     }
+    // Bytes Append writes to the stream (after the X_USER_PROFILE_SETTING array): the stored
+    // value of a WSTRING or BINARY setting, 0 for the types held in the setting itself.
+    virtual size_t data_size() const { return 0; }
     virtual std::vector<uint8_t> Serialize() const { return std::vector<uint8_t>(); }
     virtual void Deserialize(std::vector<uint8_t>) {}
     bool is_title_specific() const { return (setting_id & 0x3F00) == 0x3F00; }
@@ -152,6 +155,7 @@ class UserProfile {
     UnicodeSetting(uint32_t setting_id, const std::u16string& value)
         : Setting(setting_id, Type::WSTRING, 8, true), value(value) {}
     std::u16string value;
+    size_t data_size() const override { return value.empty() ? 0 : 2 * (value.size() + 1); }
     void Append(X_USER_PROFILE_SETTING_DATA* data, SettingByteStream* stream) override {
       Setting::Append(data, stream);
       if (value.empty()) {
@@ -183,6 +187,7 @@ class UserProfile {
     BinarySetting(uint32_t setting_id, const std::vector<uint8_t>& value)
         : Setting(setting_id, Type::BINARY, 8, true), value(value) {}
     std::vector<uint8_t> value;
+    size_t data_size() const override { return value.size(); }
     void Append(X_USER_PROFILE_SETTING_DATA* data, SettingByteStream* stream) override {
       Setting::Append(data, stream);
       if (value.empty()) {
diff --git a/src/kernel/xam/xam_user.cpp b/src/kernel/xam/xam_user.cpp
index 8778066..d5d289e 100644
--- a/src/kernel/xam/xam_user.cpp
+++ b/src/kernel/xam/xam_user.cpp
@@ -12,6 +12,7 @@
 // Disable warnings about unused parameters for kernel functions
 #pragma GCC diagnostic ignored "-Wunused-parameter"
 
+#include <algorithm>
 #include <cstring>
 
 #include <rex/cvar.h>
@@ -179,6 +180,8 @@ uint32_t XamUserReadProfileSettingsEx(uint32_t title_id, uint32_t user_index, ui
     return X_ERROR_INVALID_PARAMETER;
   }
 
+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+
   uint32_t needed_header_size = 0;
   uint32_t needed_data_size = 0;
   for (uint32_t i = 0; i < setting_count; ++i) {
@@ -187,9 +190,19 @@ uint32_t XamUserReadProfileSettingsEx(uint32_t title_id, uint32_t user_index, ui
     setting_key.value = static_cast<uint32_t>(setting_ids[i]);
     switch (static_cast<UserProfile::Setting::Type>(setting_key.type)) {
       case UserProfile::Setting::Type::WSTRING:
-      case UserProfile::Setting::Type::BINARY:
-        needed_data_size += setting_key.size;
+      case UserProfile::Setting::Type::BINARY: {
+        // The key gives the setting's nominal maximum, but a title may have stored more through
+        // XamUserWriteProfileSettings (Pirates of the Caribbean: At World's End writes 1024 bytes
+        // into the 1000-byte title-specific settings). The title allocates the buffer from the
+        // size reported here and Append writes the stored value, so report the larger of the two.
+        size_t data_size = setting_key.size;
+        auto setting = user_profile->GetSetting(setting_key.value);
+        if (setting && setting->is_set) {
+          data_size = std::max(data_size, setting->data_size());
+        }
+        needed_data_size += static_cast<uint32_t>(data_size);
         break;
+      }
       default:
         break;
     }
@@ -221,8 +234,6 @@ uint32_t XamUserReadProfileSettingsEx(uint32_t title_id, uint32_t user_index, ui
     return X_ERROR_NO_SUCH_USER;
   }
 
-  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
-
   // First call asks for size (fill buffer_size_ptr).
   // Second call asks for buffer contents with that size.
 
@@ -271,7 +282,15 @@ uint32_t XamUserReadProfileSettingsEx(uint32_t title_id, uint32_t user_index, ui
     out_setting->setting_id = setting_id;
 
     if (setting && setting->is_set) {
-      setting->Append(&out_setting->data, &out_stream);
+      // Never write past the title's buffer: the setting is left unset instead.
+      if (out_stream.offset() + setting->data_size() > buffer_size) {
+        REXKRNL_ERROR(
+            "XamUserReadProfileSettingsEx: setting {:08X} needs {} bytes at offset {} of a {} "
+            "byte buffer, skipped",
+            setting_id, setting->data_size(), out_stream.offset(), buffer_size);
+      } else {
+        setting->Append(&out_setting->data, &out_stream);
+      }
     }
     ++out_setting;
   }
-- 
