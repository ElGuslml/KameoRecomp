+    return;
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (value_mask & (uint32_t(1) << i)) {
+      colors_[index][i] = value[i];
+    }
+  }
+  component_masks_[index] |= value_mask & 0b1111;
+  if (component_masks_[index] == 0b1111) {
+    written_mask_ |= uint32_t(1) << index;
   }
