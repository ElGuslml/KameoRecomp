+    uint32_t dump_row_length_used;
+    uint32_t dump_pitch;
+    draw_util::ResolveCopyShaderIndex copy_shader;
+    draw_util::ResolveCopyShaderConstants copy_constants;
+    uint32_t copy_group_count_x, copy_group_count_y;
