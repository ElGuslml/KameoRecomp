From 8aa921de43b1cc50c664c178632ad3b693c7e082 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <ggs11@hotmail.es>
Date: Sat, 17 Oct 2026 16:15:48 -0600
Subject: [PATCH 22/24] codegen: keep the return address in the frame when
 eliding __savegprlr

With non_volatile_as_local the save and restore helpers are elided: the
registers they save are local variables. __savegprlr_N also stores r12, the
return address the caller took with mflr, into the frame's LR slot at
-8(r1); __restgprlr_N reads it back. The return itself no longer needs it,
but the guest's own stack walks do: a function that reads its caller's
return address from the stack (a renderer that tells one resolve from
another by its caller's caller, a crash handler, a profiler) found whatever
the slot held before.

The elided call now emits that one store.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/codegen/builders/context.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/codegen/builders/context.cpp b/src/codegen/builders/context.cpp
index f78e0d8..e1f17c2 100644
--- a/src/codegen/builders/context.cpp
+++ b/src/codegen/builders/context.cpp
@@ -204,7 +204,12 @@ void BuilderContext::emit_function_call(uint32_t address) {
       // frame. A share_registers function still has to elide them.
       if (cfg.nonVolatileRegistersAsLocalVariables &&
           (name.find("__rest") == 0 || name.find("__save") == 0)) {
-        // print nothing - these are handled by local variable tracking
+        // Nothing else to save or restore: the registers are local variables. __savegprlr_N's last
+        // store still matters: it puts the return address (r12, from mflr) in the frame's LR slot,
+        // where the guest's stack walks read it (a caller's caller, a crash handler).
+        if (name.find("__savegprlr_") == 0) {
+          println("	REX_STORE_U32({}.u32 + -8, {}.u32);", r(1), r(12));
+        }
         return;
       }
 
