From 2a92f0eebcccdad58d5e1541a28a3c6e40207756 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <ggs11@hotmail.es>
Date: Sat, 17 Oct 2026 16:56:26 -0600
Subject: [PATCH 24/24] cmake: stage the runtime DLLs and GPU plugins on every
 build

The host's POST_BUILD step copies rexruntime and the GPU plugins next to the
executable, but it runs only when the host links again. A change to the SDK
alone builds new DLLs without that: the GPU plugins are runtime-loaded and
never linked, and rexruntime's import library does not change while its
exports don't. The executable then ran with the old DLLs, silently.

A <target>_stage_dlls target, part of ALL and built after the host, runs the
same copies on every build (copy_if_different: nothing to do when they are
up to date).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cmake/rexglue_helpers.cmake | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/cmake/rexglue_helpers.cmake b/cmake/rexglue_helpers.cmake
index 41e6dce..b2be401 100644
--- a/cmake/rexglue_helpers.cmake
+++ b/cmake/rexglue_helpers.cmake
@@ -163,9 +163,29 @@ function(rexglue_configure_target target_name)
                 $<TARGET_FILE_DIR:${target_name}>
             VERBATIM
         )
+        list(APPEND _rexglue_staged_plugins $<TARGET_FILE:${_plugin_target}>)
         unset(_plugin_target)
     endforeach()
 
+    if(WIN32)
+        # The POST_BUILD copies run only when the host links again. A change to the SDK alone
+        # builds new DLLs without that: the GPU plugins are not linked at all, and rexruntime's
+        # import library does not change while its exports don't. The host then ran with the
+        # old DLLs. Stage them on every build as well (copy_if_different, cheap when up to date).
+        set(_rexglue_plugin_copy "")
+        if(_rexglue_staged_plugins)
+            set(_rexglue_plugin_copy COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                ${_rexglue_staged_plugins} $<TARGET_FILE_DIR:${target_name}>)
+        endif()
+        add_custom_target(${target_name}_stage_dlls ALL
+            COMMAND "$<$<BOOL:$<TARGET_RUNTIME_DLLS:${target_name}>>:${CMAKE_COMMAND};-E;copy_if_different;$<TARGET_RUNTIME_DLLS:${target_name}>;$<TARGET_FILE_DIR:${target_name}>>"
+            ${_rexglue_plugin_copy}
+            COMMAND_EXPAND_LISTS
+            VERBATIM
+        )
+        add_dependencies(${target_name}_stage_dlls ${target_name})
+    endif()
+
     if(APPLE AND REXGLUE_USE_VULKAN)
         _rexglue_stage_macos_vulkan_runtime(${target_name})
     endif()
