// Resources of KameoEOPRecomp.exe: icon (res/icon.ico, when present) and file properties.
#include <winver.h>
#include "version.h"

#ifdef KAMEORECOMP_HAS_ICON
1 ICON "icon.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION KAMEORECOMP_VERSION
PRODUCTVERSION KAMEORECOMP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Kameo: Elements of Power - KameoRecomp"
      VALUE "FileVersion", KAMEORECOMP_VERSION_STR
      VALUE "ProductName", "KameoRecomp"
      VALUE "ProductVersion", KAMEORECOMP_VERSION_STR
      VALUE "OriginalFilename", "KameoEOPRecomp.exe"
      VALUE "LegalCopyright", "KameoRecomp code: MIT License. Game content belongs to its owners."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
