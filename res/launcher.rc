// Resources of "Kameo Launcher.exe": icon (res/icon.ico, when present), file properties, and the launcher's fonts
// (recomp_launcher/fonts) and art (launcher/art), found through the include directories (RecompLauncher.cmake).
#include <winver.h>
#include "version.h"
#include "launcher_version.h"
#include "resources.h"

#ifdef KAMEORECOMP_HAS_ICON
1 ICON "icon.ico"
#endif

IDR_FONT_REGULAR RCDATA "fonts/SourceSans3-Regular.ttf"
IDR_FONT_MEDIUM RCDATA "fonts/SourceSans3-Medium.ttf"
IDR_FONT_SEMIBOLD RCDATA "fonts/SourceSans3-SemiBold.ttf"
IDR_FONT_BOLD RCDATA "fonts/SourceSans3-Bold.ttf"
IDR_FONT_DISPLAY_MEDIUM RCDATA "fonts/Oswald-Medium.ttf"
IDR_FONT_DISPLAY_SEMIBOLD RCDATA "fonts/Oswald-SemiBold.ttf"
IDR_FONT_DISPLAY_BOLD RCDATA "fonts/Oswald-Bold.ttf"
IDR_ART_BACKGROUND RCDATA "art/background.svg"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RECOMP_LAUNCHER_VERSION
PRODUCTVERSION KAMEORECOMP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Kameo Launcher - options for KameoRecomp"
      VALUE "FileVersion", RECOMP_LAUNCHER_VERSION_STR
      VALUE "ProductName", "KameoRecomp"
      VALUE "ProductVersion", KAMEORECOMP_VERSION_STR
      VALUE "OriginalFilename", "Kameo Launcher.exe"
      VALUE "LegalCopyright", "KameoRecomp code: MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
